local function searchScriptblox(query)
    local ok, response = pcall(function()
        return game:HttpGetAsync("https://scriptblox.com/api/script/search?q=" .. HttpService:UrlEncode(query) .. "&max=20")
    end)
    if not ok then Notify("Frostium", "Scriptblox request failed", 2); return end
    local decodeOk, decoded = pcall(function() return HttpService:JSONDecode(response) end)
    if not decodeOk or not decoded or not decoded.result or not decoded.result.scripts then
        Notify("Frostium", "No Scriptblox results", 2); return
    end
    for _, s in ipairs(decoded.result.scripts) do
        local img = s.isUniversal and "rbxassetid://128637488250626" or (s.game and s.game.imageUrl) or "rbxassetid://128637488250626"
        makeResultCard(s.title or "Unknown", (s.owner and s.owner.username) or "???", img, s.script or "")
    end
