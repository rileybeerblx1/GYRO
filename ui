end)

local function highlightLua(src)
    local keywords = {
        ["and"]=1,["break"]=1,["or"]=1,["else"]=1,["elseif"]=1,["if"]=1,["then"]=1,["until"]=1,["repeat"]=1,
        ["while"]=1,["do"]=1,["for"]=1,["in"]=1,["end"]=1,["local"]=1,["return"]=1,["function"]=1,["export"]=1,
        ["continue"]=1,["type"]=1
    }
    local builtins = {
        ["game"]=1,["workspace"]=1,["script"]=1,["math"]=1,["string"]=1,["table"]=1,["task"]=1,["wait"]=1,
        ["select"]=1,["next"]=1,["Enum"]=1,["error"]=1,["warn"]=1,["tick"]=1,["assert"]=1,["shared"]=1,
        ["loadstring"]=1,["tonumber"]=1,["tostring"]=1,["typeof"]=1,["unpack"]=1,["print"]=1,["Instance"]=1,
        ["CFrame"]=1,["Vector3"]=1,["Vector2"]=1,["Color3"]=1,["UDim"]=1,["UDim2"]=1,["Ray"]=1,
        ["BrickColor"]=1,["OverlapParams"]=1,["RaycastParams"]=1,["Random"]=1,["Region3"]=1,["Rect"]=1,
        ["TweenInfo"]=1,["collectgarbage"]=1,["not"]=1,["utf8"]=1,["pcall"]=1,["xpcall"]=1,["_G"]=1,
        ["setmetatable"]=1,["getmetatable"]=1,["os"]=1,["pairs"]=1,["ipairs"]=1,["require"]=1
    }
    local function esc(s) return s:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;") end
    local out, i, n = {}, 1, #src
    while i <= n do
        local c = src:sub(i, i)
        if c == "-" and src:sub(i, i + 1) == "--" then
            local nl = src:find("\n", i, true)
            local comment = nl and src:sub(i, nl - 1) or src:sub(i)
            table.insert(out, '<font color="#6b7a99">' .. esc(comment) .. '</font>')
            i = nl or (n + 1)
        elseif c == '"' or c == "'" then
            local j = i + 1
            while j <= n do
                if src:sub(j, j) == "\\" then j = j + 2
                elseif src:sub(j, j) == c then j = j + 1; break
                else j = j + 1 end
            end
            table.insert(out, '<font color="#7ee787">' .. esc(src:sub(i, j - 1)) .. '</font>')
            i = j
        elseif c:match("%d") then
            local j = i
            while j <= n and src:sub(j, j):match("[%d%.xXa-fA-F]") do j = j + 1 end
            table.insert(out, '<font color="#ffa657">' .. esc(src:sub(i, j - 1)) .. '</font>')
            i = j
        elseif c:match("[%a_]") then
            local j = i
            while j <= n and src:sub(j, j):match("[%w_]") do j = j + 1 end
            local word = src:sub(i, j - 1)
            if keywords[word] then table.insert(out, '<font color="#ff7b72">' .. word .. '</font>')
            elseif builtins[word] then table.insert(out, '<font color="#79c0ff">' .. word .. '</font>')
            else table.insert(out, '<font color="#e6edf3">' .. word .. '</font>') end
            i = j
        else
            table.insert(out, '<font color="#e6edf3">' .. esc(c) .. '</font>')
            i = i + 1
        end
    end
    return table.concat(out)
end

