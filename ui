local function updateLinesAndHighlight()
    local src = codeBox.Text
    local count = 1
    for _ in src:gmatch("\n") do count = count + 1 end
    local nums = {}
    for i = 1, count do nums[i] = tostring(i) end
    lineNumbers.Text = table.concat(nums, "\n")
    if #src > 0 and not codeBox:IsFocused() then
        highlightLabel.Text = highlightLua(src)
        highlightLabel.Visible = true
    else
        highlightLabel.Visible = false
    end
end

