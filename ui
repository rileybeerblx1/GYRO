local function create(class, props, parent)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do
        obj[k] = v
    end
    if parent then obj.Parent = parent end
    return obj
end

local function corner(parent, px)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, px)
    c.Parent = parent
    return c
end

local function stroke(parent, color, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color or Color3.fromRGB(140, 190, 255)
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0.4
    s.Parent = parent
    return s
end

local function gradient(parent, rotation)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(170, 215, 255)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(110, 175, 255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(70, 135, 230))
    })
    g.Rotation = rotation or 45
    g.Parent = parent
    return g
end

local FROST_HIGHLIGHT = Color3.fromRGB(120, 190, 255)

local function tween(obj, props, time)
    local t = TweenService:Create(obj, TweenInfo.new(time or 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

local function scaleForDevice()
    local cam = workspace.CurrentCamera
    local size = cam and cam.ViewportSize or Vector2.new(1280, 720)
    if size.X < 600 then return 0.85 end
    if size.X < 900 then return 0.95 end
    if size.X > 1600 then return 1.05 end
    return 1
end

