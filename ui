switchTab = function(tabName)
    for _, t in pairs(tabsFolder:GetChildren()) do
        if t:IsA("Frame") then
            t.Visible = (t.Name == tabName)
        end
    end
    local buttons = {User = userBtn, Home = homeBtn, Editor = editorBtn, Scripts = scriptsBtn, Settings = settingsBtn}
    for name, btn in pairs(buttons) do
        if name == tabName then
            tween(btn, {ImageColor3 = FROST_HIGHLIGHT}, 0.15)
        else
            tween(btn, {ImageColor3 = Color3.fromRGB(255, 255, 255)}, 0.15)
        end
    end
end

