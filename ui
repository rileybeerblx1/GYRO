local function searchRScripts(query, key)
    if not key or #key < 10 then Notify("Frostium", "RScripts API key required", 3); return end
    local ok, response = pcall(function()
        return game:HttpGetAsync("https://api.rscripts.net/v1/search?q=" .. HttpService:UrlEncode(query) .. "&index=scripts&limit=20", true, {["Authorization"] = "Bearer " .. key})
    end)
    if not ok then Notify("Frostium", "RScripts request failed", 2); return end
    local decodeOk, decoded = pcall(function() return HttpService:JSONDecode(response) end)
    if not decodeOk or not decoded or not decoded.success or not decoded.data then
        Notify("Frostium", "No RScripts results", 2); return
    end
    local scripts = decoded.data.scripts or decoded.data
    if type(scripts) ~= "table" then return end
    for _, s in ipairs(scripts) do
        local img = s.image or s.thumbnail or "rbxassetid://128637488250626"
        local src = s.script or s.rawScript or ""
        if #src == 0 and s.slug then
            local rawOk, raw = pcall(function()
                return game:HttpGet("https://api.rscripts.net/v1/scripts/" .. s.slug, true, {["Authorization"] = "Bearer " .. key})
            end)
            if rawOk then
                local rawDecoded = HttpService:JSONDecode(raw)
                src = rawDecoded.data and rawDecoded.data.script or ""
            end
        end
        makeResultCard(s.title or s.name or "Unknown", (s.owner and s.owner.username) or "???", img, src)
    end
end

