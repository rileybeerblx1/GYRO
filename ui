local dragging = false
local dragStart, dragStartPos, dragTarget
local dragMoved = false

local function startDrag(frame, input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragTarget = frame
        dragStart = input.Position
        dragStartPos = frame.Position
        dragMoved = false
    end
end

local function endDrag(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
        dragTarget = nil
    end
end

mainFrame.InputBegan:Connect(function(input) startDrag(mainFrame, input) end)
mainFrame.InputEnded:Connect(endDrag)
toggleBtn.InputBegan:Connect(function(input) startDrag(toggleBtn, input) end)
toggleBtn.InputEnded:Connect(endDrag)

UserInputService.InputChanged:Connect(function(input)
    if dragging and dragTarget and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        if delta.Magnitude > 4 then dragMoved = true end
        dragTarget.Position = UDim2.new(
            dragStartPos.X.Scale,
            dragStartPos.X.Offset + delta.X,
            dragStartPos.Y.Scale,
            dragStartPos.Y.Offset + delta.Y
        )
    end
end)

